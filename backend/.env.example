
APP_NAME=India Green Grid
APP_ENV=development
DEBUG=false
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=solarequity

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

AUTO_CREATE_TABLES=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

FORECAST_LIVE_WEATHER_ENABLED=true
FORECAST_WEATHER_TIMEOUT_SECONDS=6
FORECAST_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

DEMO_ADMIN_NAME=Society Administrator
DEMO_ADMIN_EMAIL=admin@solarequity.com
DEMO_ADMIN_PASSWORD=change-this-admin-password

DEMO_RESIDENT_1_NAME=Resident 101
DEMO_RESIDENT_2_NAME=Resident 102
DEMO_RESIDENT_1_EMAIL=resident101@solarequity.com
DEMO_RESIDENT_2_EMAIL=resident102@solarequity.com
DEMO_RESIDENT_PASSWORD=change-this-resident-password
